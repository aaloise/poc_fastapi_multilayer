# Environment variables for Async POC
# Copy to .env and customize

# App
POC_APP_NAME=Async POC
POC_DEBUG=true
POC_ENVIRONMENT=development

# Server
POC_HOST=0.0.0.0
POC_PORT=8000
POC_WORKERS=4

# Database (async SQLAlchemy)
POC_DATABASE_URL=sqlite+aiosqlite:///./poc.db
POC_DATABASE_ECHO=false

# Queuefy
POC_QUEUE_STORE=sqlalchemy
POC_QUEUE_REDIS_URL=redis://localhost:6379/0
POC_QUEUE_CONCURRENCY=8

# Prefect
POC_PREFECT_API_URL=http://localhost:4200/api
POC_PREFECT_ENABLED=true

# NiceGUI
POC_NICEGUI_PREFIX=/ui
POC_NICEGUI_TITLE=Async POC Dashboard
